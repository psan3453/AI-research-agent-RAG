# ==============================================================================
# AI Research Assistant RAG - Environment Configuration
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your real API keys.
# Do NOT commit your actual .env file to version control.
# ==============================================================================

# Groq API Key (Required for Research Assistant and Document Q&A LLMs)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Required for Summarization, Web Search, and Embeddings)
# You can set either GEMINI_API_KEY or GOOGLE_API_KEY
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Pinecone API Key (Required for Document Q&A vector database)
# Obtain from: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=research-rag
PINECONE_ENVIRONMENT=us-east-1

# Optional Model Configuration Overrides
# Supported Groq Models: llama-3.3-70b-versatile, llama-3.1-8b-instant, gemma2-9b-it, deepseek-r1-distill-llama-70b
GROQ_MODEL=llama-3.3-70b-versatile

# Supported Gemini Models: gemini-1.5-flash, gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-pro-002, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash
